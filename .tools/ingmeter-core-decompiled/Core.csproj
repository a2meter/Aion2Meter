    <EmbeddedResource Include="INGMeter.assets.mobs.json" LogicalName="INGMeter.assets.mobs.json" />
    <EmbeddedResource Include="INGMeter.assets.dungeons.json" LogicalName="INGMeter.assets.dungeons.json" />
    <EmbeddedResource Include="INGMeter.assets.dungeon_boss_mob_codes.json" LogicalName="INGMeter.assets.dungeon_boss_mob_codes.json" />
    <EmbeddedResource Include="INGMeter.assets.buffs_ko.json" LogicalName="INGMeter.assets.buffs_ko.json" />
    <EmbeddedResource Include="INGMeter.assets.rdps_party_buff_effects.json" LogicalName="INGMeter.assets.rdps_party_buff_effects.json" />
    <EmbeddedResource Include="INGMeter.assets.rdps_skill_catalog.json" LogicalName="INGMeter.assets.rdps_skill_catalog.json" />
