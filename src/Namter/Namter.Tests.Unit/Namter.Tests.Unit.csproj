<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NamterNativeOutput>$(MSBuildThisFileDirectory)..\Namter.Core.Native\x64\$(Configuration)\Namter.Core.Native.dll</NamterNativeOutput>
    <NamterVcpkgRoot>$(MSBuildThisFileDirectory)..\..\..\vcpkg_installed\x64-windows\x64-windows</NamterVcpkgRoot>
    <NamterNativeLz4 Condition="'$(Configuration)' == 'Debug'">$(NamterVcpkgRoot)\debug\bin\lz4d.dll</NamterNativeLz4>
    <NamterNativeLz4 Condition="'$(Configuration)' != 'Debug'">$(NamterVcpkgRoot)\bin\lz4.dll</NamterNativeLz4>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Namter.Core.Native\Namter.Core.Native.vcxproj"
                      Condition="'$(MSBuildRuntimeType)' == 'Full'"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="..\Namter.Core.Interop\Namter.Core.Interop.csproj" />
    <ProjectReference Include="..\Namter.GameData\Namter.GameData.csproj" />
    <ProjectReference Include="..\Namter.GameData.Builder\Namter.GameData.Builder.csproj" />
    <ProjectReference Include="..\Namter.GameData.Publisher\Namter.GameData.Publisher.csproj" />
    <ProjectReference Include="..\Namter.Encounter\Namter.Encounter.csproj" />
  </ItemGroup>
  <Target Name="CopyNamterNative" BeforeTargets="Build">
    <Error Condition="!Exists('$(NamterNativeOutput)')" Text="Build Namter.Core.Native $(Configuration)|x64 before running managed ABI tests." />
    <Error Condition="!Exists('$(NamterNativeLz4)')" Text="Build Namter.Core.Native $(Configuration)|x64 with its LZ4 runtime before running managed ABI tests." />
    <Copy SourceFiles="$(NamterNativeOutput);$(NamterNativeLz4)" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
